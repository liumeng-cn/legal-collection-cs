# 镜像 Java backend/.env 的 embedding 配置，双侧必须一致（同模型同维度）
# qwen3-vl-embedding 走 DashScope 原生多模态接口，base_url 用根域名
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=qwen3-vl-embedding

# knowledge 库连接串（镜像 Java datasource.knowledge）
KNOWLEDGE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/knowledge

# 分块配置（均有默认值，可选）
CHUNK_STRATEGY=hybrid
CHUNK_TARGET_CHARS=512
CHUNK_OVERLAP_CHARS=64
CHUNK_MIN_CHARS=128
CHUNK_MAX_CHARS=1024
